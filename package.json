{
  "name": "open-higgs",
  "version": "0.4.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:studio && python tests/worker_e2e.py",
    "test:render": "python tests/render_e2e.py",
    "format": "prettier --write server/studio.ts server/studio-tools.ts src/pages/Studio.tsx src/pages/StudioControls.tsx src/pages/StudioQueue.tsx src/pages/studio.css src/pages/studio-controls.css src/pages/studio-queue.css tests/studio.test.ts tests/worker-host.ts",
    "format:check": "prettier --check server/studio.ts server/studio-tools.ts src/pages/Studio.tsx src/pages/StudioControls.tsx src/pages/StudioQueue.tsx src/pages/studio.css src/pages/studio-controls.css src/pages/studio-queue.css tests/studio.test.ts tests/worker-host.ts",
    "test:studio": "tsx --test tests/studio.test.ts",
    "dev": "concurrently -n server,web -c red,blue \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --production",
    "test:judge": "tsx scripts/test-judge.ts",
    "test:h3-turbo": "tsx scripts/test-h3-turbo.ts",
    "test:video-decode": "tsx scripts/test-video-decode.ts",
    "test:model-switch": "tsx scripts/test-model-switch.ts",
    "test:ltxfiles": "tsx scripts/test-ltxfiles.ts",
    "test:llm-planner": "tsx scripts/test-llm-planner.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json && tsc -p mcp/tsconfig.json",
    "models": "tsx scripts/fetch-models.ts",
    "doctor": "tsx scripts/doctor.ts",
    "docs:models": "tsx scripts/gen-models-doc.ts",
    "presets": "tsx scripts/render-presets.ts",
    "effects:preview": "tsx scripts/effect-preview.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:smoke": "tsx mcp/smoke.ts",
    "mcp:check": "tsx mcp/bodies.check.ts",
    "shotlist:check": "tsx scripts/check-shotlist.ts",
    "workflows": "tsx scripts/export-workflows.ts"
  },
  "dependencies": {
    "@comfyorg/sdk": "^0.5.0",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/three": "^0.186.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "prettier": "3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "description": "An open-source AI filmmaking studio with a story canvas, render queue, paid APIs, local ComfyUI and Kaggle twin T4 workers.",
  "repository": {"type":"git","url":"https://github.com/tosind/open-higgs.git"},
  "bugs": {"url":"https://github.com/tosind/open-higgs/issues"},
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
